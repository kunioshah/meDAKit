# ==========================================
# API KEYS FOR MEDICAL IMAGE DATA PIPELINE
# ==========================================

# 1. Kaggle
# Go to kaggle.com -> Settings -> Create New API Token
# Paste the values from the downloaded kaggle.json here:
KAGGLE_USERNAME=your_kaggle_username
KAGGLE_KEY=your_kaggle_api_key

# 2. Roboflow
# Go to your Roboflow workspace -> Settings -> API Keys
ROBOFLOW_API_KEY=your_roboflow_private_workspace_api_key

# 3. HuggingFace
# Go to huggingface.co -> Settings -> Access Tokens (Generate a READ token)
HF_TOKEN=your_huggingface_read_token
